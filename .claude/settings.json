{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== docs/state.md ===' && cat docs/state.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️  Session ending — run /handoff to update HANDOFF.md before you go.'"
          }
        ]
      }
    ]
  }
}
